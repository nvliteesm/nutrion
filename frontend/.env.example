# Supabase (same project as backend) — required for Google OAuth
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key

# FastAPI backend
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# --- Google Auth console setup (one-time) ---
# 1. Google Cloud Console → Credentials → OAuth client (Web)
#    Authorized JS origins: http://localhost:3000
#    Authorized redirect URI: https://YOUR_PROJECT.supabase.co/auth/v1/callback
# 2. Supabase → Authentication → Providers → Google → paste Client ID + Secret
# 3. Supabase → Authentication → URL Configuration
#    Site URL: http://localhost:3000
#    Redirect allow list: http://localhost:3000/auth/callback
