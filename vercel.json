{
  "version": 2,
  "builds": [
    {
      "src": "frontend/package.json",
      "use": "@vercel/next"
    },
    {
      "src": "backend/requirements.txt",
      "use": "@vercel/python",
      "config": {
        "maxLambdaSize": "50mb"
      }
    }
  ],
  "routes": [
    { "src": "/api/(.*)", "dest": "backend/app/main.py" },
    { "src": "/intakes(.*)", "dest": "backend/app/main.py" },
    { "src": "/memory/(.*)", "dest": "backend/app/main.py" },
    { "src": "/health", "dest": "backend/app/main.py" },
    { "src": "/chat", "dest": "backend/app/main.py" },
    { "src": "/uploads/(.*)", "dest": "backend/app/main.py" },
    { "src": "/(.*)", "dest": "frontend/$1" }
  ]
}
