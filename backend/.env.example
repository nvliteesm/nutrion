# Prefer DATABASE_URL (Supabase Postgres URI). Falls back to local SQLite if unset.
# Use Session pooler (port 5432) for SQLAlchemy/asyncpg. Host may be aws-0- or aws-1-.
# Example:
# DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-1-ap-south-1.pooler.supabase.com:5432/postgres
DATABASE_URL=
DATABASE_SSL=
# Set false on campus/corporate networks that MITM TLS
DATABASE_SSL_VERIFY=true

# Optional Supabase project keys (auth/storage later)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Account B - model deployment (chat / embeddings)
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=https://nutrion-resource.services.ai.azure.com/openai/v1
AZURE_AI_PROJECT_ENDPOINT=https://nutrion-resource.services.ai.azure.com/api/projects/nutrion
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5-mini
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small

# Account A - Content Understanding (OCR / documents)
AZURE_CONTENT_ENDPOINT=https://nutri-on-resource.services.ai.azure.com
AZURE_CONTENT_API_KEY=
AZURE_CONTENT_ANALYZER=prebuilt-layout
AZURE_CONTENT_API_VERSION=2025-11-01

# Kimi / Moonshot Vision - food photos
KIMI_API_KEY=
KIMI_BASE_URL=https://api.moonshot.ai/v1
KIMI_VISION_MODEL=kimi-k3

USE_LIVE_AI=true
ALLOW_STUB_EMBEDDINGS=true
CORS_ORIGINS=http://localhost:3000
